{
  "openapi": "3.0.3",
  "info": {
    "title": "QA Lab API",
    "version": "1.0.0",
    "description": "API de comercio, inventario y operaciones con autorización por roles."
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Login",
        "responses": {
          "200": {
            "description": "Token"
          },
          "401": {
            "description": "Credenciales inválidas"
          },
          "423": {
            "description": "Cuenta bloqueada"
          }
        }
      }
    },
    "/products": {
      "get": {
        "summary": "Catálogo",
        "responses": {
          "200": {
            "description": "Operación completada"
          }
        }
      },
      "post": {
        "summary": "Crear producto",
        "responses": {
          "200": {
            "description": "Operación completada"
          }
        }
      }
    },
    "/reservations": {
      "get": {
        "summary": "Reservas",
        "responses": {
          "200": {
            "description": "Operación completada"
          }
        }
      },
      "post": {
        "summary": "Crear reserva",
        "responses": {
          "200": {
            "description": "Operación completada"
          }
        }
      }
    },
    "/movements": {
      "get": {
        "summary": "Movimientos",
        "responses": {
          "200": {
            "description": "Operación completada"
          }
        }
      },
      "post": {
        "summary": "Transferir stock",
        "responses": {
          "200": {
            "description": "Operación completada"
          }
        }
      }
    },
    "/claims": {
      "get": {
        "summary": "Siniestros",
        "responses": {
          "200": {
            "description": "Operación completada"
          }
        }
      },
      "post": {
        "summary": "Crear siniestro",
        "responses": {
          "200": {
            "description": "Operación completada"
          }
        }
      }
    },
    "/events": {
      "get": {
        "summary": "Eventos",
        "responses": {
          "200": {
            "description": "Operación completada"
          }
        }
      },
      "post": {
        "summary": "Publicar evento",
        "responses": {
          "200": {
            "description": "Operación completada"
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "summary": "Registrar un cliente",
        "parameters": [
          {
            "in": "header",
            "name": "X-Lab-Id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "username",
                  "password",
                  "confirmPassword"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 100
                  },
                  "username": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_]{3,32}$"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 12,
                    "maxLength": 128
                  },
                  "confirmPassword": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario, token de sesión y duración"
          },
          "409": {
            "description": "Usuario existente"
          },
          "422": {
            "description": "Datos inválidos"
          },
          "429": {
            "description": "Demasiadas solicitudes"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
